# Optional: override API URL (used when set).
# If not set, the app uses http://localhost:3001/api in development (npm run dev)
# and same-origin /api in production (via frontend vercel.json rewrites).
# VITE_API_URL=http://localhost:3001/api

# Frontend base URL used to generate absolute links for clients/admin pages.
# Use one of:
# - https://www.kanridesign.com
# - https://kanridesign.com
VITE_FRONTEND_URL=https://www.kanridesign.com

# Backend API base URL (used by src/services/api.ts)
# Use localhost for local testing
VITE_API_URL=http://localhost:3001/api
# Keep deployed backend URL separately so you can switch back quickly
VITE_API_URL_DEPLOYED=https://backend-kappa-khaki-71.vercel.app/api
# Optional: force professional delivery link base URL
# If omitted, frontend uses API base without /api.
VITE_DELIVERY_BASE_URL=https://backend-kappa-khaki-71.vercel.app
